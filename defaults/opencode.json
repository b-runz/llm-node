{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "provider": {
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://freellmapi.llm.svc.cluster.local:3001/v1",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "auto": { "name": "auto" }
      }
    }
  },
  "model": "freellmapi/auto"
}
